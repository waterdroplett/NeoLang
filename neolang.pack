    {
      "path": "Makefile",
      "encoding": "utf-8",
      "content": "CC = gcc\nCFLAGS = -Wall -Wextra -Iinclude -g\n\nSRC = $(wildcard src/*.c)\n# Put your real program name after bin/\nOUT = bin/neolang\n\nall:\n\tmkdir -p bin\n\t$(CC) $(CFLAGS) $(SRC) -o $(OUT)\n\nclean:\n\trm -f $(OUT)\n\n.PHONY: all clean"
    },
