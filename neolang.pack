      "path": "bin/neolang",
      "encoding": "base64",
      "content": ""
    },
    {
      "path": "include/colors.h",
      "encoding": "utf-8",
      "content": "#ifndef COLORS_H\n#define COLORS_H\n\n/* Reset */\n#define C_RESET          \"\\033[0m\"  // Reset all formatting\n\n/* Standard foreground colors */\n#define C_BLACK          \"\\033[30m\" // Black\n#define C_RED            \"\\033[31m\" // Red\n#define C_GREEN          \"\\033[32m\" // Green\n#define C_YELLOW         \"\\033[33m\" // Yellow\n#define C_BLUE           \"\\033[34m\" // Blue\n#define C_MAGENTA        \"\\033[35m\" // Magenta\n#define C_CYAN           \"\\033[36m\" // Cyan\n#define C_WHITE          \"\\033[37m\" // White\n\n/* Bright foreground colors */\n#define C_BRIGHT_BLACK   \"\\033[90m\" // Bright black (gray)\n#define C_BRIGHT_RED     \"\\033[91m\" // Bright red\n#define C_BRIGHT_GREEN   \"\\033[92m\" // Bright green\n#define C_BRIGHT_YELLOW  \"\\033[93m\" // Bright yellow\n#define C_BRIGHT_BLUE    \"\\033[94m\" // Bright blue\n#define C_BRIGHT_MAGENTA \"\\033[95m\" // Bright magenta\n#define C_BRIGHT_CYAN    \"\\033[96m\" // Bright cyan\n#define C_BRIGHT_WHITE  \"\\033[97m\" // Bright white\n\n/* Standard background colors */\n#define C_BG_BLACK       \"\\033[40m\" // Black background\n#define C_BG_RED         \"\\033[41m\" // Red background\n#define C_BG_GREEN       \"\\033[42m\" // Green background\n#define C_BG_YELLOW      \"\\033[43m\" // Yellow background\n#define C_BG_BLUE        \"\\033[44m\" // Blue background\n#define C_BG_MAGENTA     \"\\033[45m\" // Magenta background\n#define C_BG_CYAN        \"\\033[46m\" // Cyan background\n#define C_BG_WHITE       \"\\033[47m\" // White background\n\n/* Bright background colors */\n#define C_BG_BRIGHT_BLACK   \"\\033[100m\" // Bright black background\n#define C_BG_BRIGHT_RED     \"\\033[101m\" // Bright red background\n#define C_BG_BRIGHT_GREEN   \"\\033[102m\" // Bright green background\n#define C_BG_BRIGHT_YELLOW  \"\\033[103m\" // Bright yellow background\n#define C_BG_BRIGHT_BLUE    \"\\033[104m\" // Bright blue background\n#define C_BG_BRIGHT_MAGENTA \"\\033[105m\" // Bright magenta background\n#define C_BG_BRIGHT_CYAN    \"\\033[106m\" // Bright cyan background\n#define C_BG_BRIGHT_WHITE   \"\\033[107m\" // Bright white background\n\n/* Text formatting */\n#define C_BOLD           \"\\033[1m\" // Bold text\n#define C_DIM            \"\\033[2m\" // Dim text\n#define C_ITALIC         \"\\033[3m\" // Italic text\n#define C_UNDERLINE      \"\\033[4m\" // Underlined text\n#define C_BLINK          \"\\033[5m\" // Blinking text\n#define C_INVERT         \"\\033[7m\" // Invert foreground/background\n#define C_HIDDEN         \"\\033[8m\" // Hidden text\n#define C_STRIKE         \"\\033[9m\" // Strikethrough text\n\n/* Formatting controls */\n#define C_NO_BOLD_DIM    \"\\033[22m\" // Disable bold and dim\n#define C_NO_ITALIC      \"\\033[23m\" // Disable italic\n#define C_NO_UNDERLINE   \"\\033[24m\" // Disable underline\n#define C_NO_BLINK       \"\\033[25m\" // Disable blinking\n#define C_NO_INVERT      \"\\033[27m\" // Disable inversion\n#define C_NO_HIDDEN      \"\\033[28m\" // Disable hidden text\n#define C_NO_STRIKE      \"\\033[29m\" // Disable strikethrough\n\n/* 256-color foreground colors */\n#define C_ORANGE         \"\\033[38;5;208m\" // Orange\n#define C_PINK           \"\\033[38;5;205m\" // Pink\n#define C_PURPLE         \"\\033[38;5;135m\" // Purple\n#define C_GRAY           \"\\033[38;5;245m\" // Gray\n\n/* 256-color background colors */\n#define C_BG_ORANGE      \"\\033[48;5;208m\" // Orange background\n#define C_BG_PINK        \"\\033[48;5;205m\" // Pink background\n#define C_BG_PURPLE      \"\\033[48;5;135m\" // Purple background\n#define C_BG_GRAY        \"\\033[48;5;245m\" // Gray background\n\n#endif"
    },
    {
      "path": "include/lexer.h",
      "encoding": "utf-8",
      "content": "#ifndef NEOLANG_LEXER_H\n#define NEOLANG_LEXER_H\n\n#define MAX_LEXEME_VALUE 64\n\ntypedef enum \n{\n    TOKEN_IDENTIFIER,\n    TOKEN_NUMBER,\n    TOKEN_HEX,\n    TOKEN_STRING,\n\n    TOKEN_VAR,\n\n    TOKEN_PLUS,\n    TOKEN_MINUS,\n    TOKEN_STAR,\n    TOKEN_SLASH,\n\n    TOKEN_EQUAL,\n    TOKEN_DOUBLE_EQUAL,\n    TOKEN_NOT_EQUAL,\n\n    TOKEN_SEMICOLON,\n    TOKEN_COLON,\n    TOKEN_COMMA,\n\n    TOKEN_LPAREN,\n    TOKEN_RPAREN,\n    TOKEN_LBRACKET,\n    TOKEN_RBRACKET,\n    TOKEN_LCURLY,\n    TOKEN_RCURLY,\n\n    TOKEN_UNKNOWN,\n} TokenType;\n\ntypedef struct \n{\n    char lexeme[MAX_LEXEME_VALUE];\n    TokenType type;\n\n    unsigned int column;\n    unsigned int line;\n} Token;\n\ntypedef struct \n{\n    Token *tokens;\n    unsigned int count;\n} TokenList;\n\nint lexer_lex(const char *filename, TokenList *tokens);\n\n#endif"
    },
    {
      "path": "include/neostd.h",
      "encoding": "utf-8",
      "content": "#ifndef NEOLANG_NEOSTD_H\n#define NEOLANG_NEOSTD_H\n\nint iswhitespace(char c);\nint isnum(char c);\nint isxnum(char c);\nint isalphalet(char c);\n\nunsigned long strtolu(char *__restrict__ _str, int *__restrict__ _failed);\n\n#endif"
    },
    {
      "path": "include/parser.h",
      "encoding": "utf-8",
      "content": "#ifndef NEOLANG_PARSER_H\n#define NEOLANG_PARSER_H\n\n#include \"lexer.h\"\n#include <stdio.h>\n\ntypedef struct ASTNode ASTNode;\n\ntypedef enum \n{\n    AST_PROGRAM,\n    AST_INTEGER,\n    AST_HEX,\n    AST_BINARY,\n    AST_VARIABLE,\n    AST_STRING,\n    AST_DECLARATION,\n} ASTNodeType;\n\ntypedef struct \n{\n    ASTNode **statements;\n    size_t count;\n} ASTProgram;\n\nstruct ASTNode\n{\n    ASTNodeType type;\n\n    union \n    {\n        ASTProgram program;\n\n        int integer;\n        unsigned long hex;\n\n        struct \n        {\n            ASTNode *left;\n            ASTNode *right;\n            int oper;\n        } binary;\n\n        char variable_name[MAX_LEXEME_VALUE];\n\n        struct \n        {\n            ASTNode *name;\n            ASTNode *value;\n        } declaration;\n    } data;\n};\n\ntypedef struct \n{\n    TokenList *tokens;\n    size_t current;\n    ASTProgram *program;\n} Parser;\n\nint is_at_end(Parser *parser);\n\nToken *previous(Parser *parser);\n\nToken *advance(Parser *parser);\n\nToken *peek(Parser *parser);\n\nASTProgram *ast_program_create(void);\nint node_create(ASTNode *parent, ASTNode child);\nint parser_parse(Parser *parser);\n\n#endif"
    },
    {
      "path": "src/lexer.c",
      "encoding": "utf-8",
      "content": "#include \"lexer.h\"\n#include \"neostd.h\"\n#include \"colors.h\"\n#include <stdio.h>\n#include <string.h>\n#include <stdlib.h>\n\nint add_token(TokenList *tokens, char *lexeme, TokenType type, unsigned int line, int column)\n{\n    {\n        void *temp = realloc(tokens->tokens,(tokens->count + 1) * sizeof(Token));\n        if (temp != NULL)\n        {\n            tokens->tokens = temp;\n        }\n        else\n        {\n            return 1;\n        }\n    }\n    tokens->tokens[tokens->count].column = column;\n    tokens->tokens[tokens->count].line = line;\n    tokens->tokens[tokens->count].type = type;\n    strcpy(tokens->tokens[tokens->count].lexeme,lexeme);\n    tokens->count++;\n    return 0;\n}\n\nint realloc_tokens(TokenList *tokens, size_t amount)\n{\n    void *temp = realloc(tokens->tokens,(tokens->count + amount) * sizeof(Token));\n    if (temp != NULL)\n    {\n        tokens->tokens = temp;\n    }\n    else\n    {\n        return 1;\n    }\n    return 0;\n}\n\nint lexer_lex(const char *filename, TokenList *tokens)\n{\n    FILE *file = fopen(filename,\"r\");\n    if (!file)\n    {\n        printf(C_RED\"neolang: failed to open '%s'\\n\"C_RESET, filename);\n        return 1;\n    }\n\n    tokens->count = 0;\n\n    char buf[512];\n\n    unsigned int line = 0;\n    int i = 0;\n    while (fgets(buf,sizeof(buf),file))\n    {\n        line++;\n        i = 0;\n        while (buf[i] != '\\n' && buf[i] != '\\0')\n        {\n            if (iswhitespace(buf[i]))\n            {\n                i++;\n            }\n            else if (buf[i] == '/' && buf[i+1] == '/')\n            {\n                break;\n            }\n            else if (isnum(buf[i]))\n            {\n                int success = realloc_tokens(tokens,1);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                int start = i;\n                tokens->tokens[tokens->count].column = i;\n                tokens->tokens[tokens->count].line = line;\n                if ((buf[i+1] == 'x' || buf[i+1] == 'X') && isxnum(buf[i+2]))\n                {\n                    i += 2;\n                    while (isxnum(buf[i]))\n                    {\n                        i++;\n                    }\n                    tokens->tokens[tokens->count].type = TOKEN_HEX;\n                }\n                else\n                {\n                    while (isnum(buf[i]))\n                    {\n                        i++;\n                    }\n                    tokens->tokens[tokens->count].type = TOKEN_NUMBER;\n                }\n                int n = i - start;\n                strncpy(tokens->tokens[tokens->count].lexeme,buf + start,n);\n                tokens->tokens[tokens->count].lexeme[n] = '\\0';\n                tokens->count++;\n            }\n            else if (isalphalet(buf[i]))\n            {\n                int success = realloc_tokens(tokens,1);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                int start = i;\n                tokens->tokens[tokens->count].column = i;\n                tokens->tokens[tokens->count].line = line;\n                while (isalphalet(buf[i]) || isnum(buf[i]) || buf[i] == '_')\n                {\n                    i++;\n                }\n                int n = i - start;\n                strncpy(tokens->tokens[tokens->count].lexeme,buf + start,n);\n                tokens->tokens[tokens->count].lexeme[n] = '\\0';\n                if (!strcmp(tokens->tokens[tokens->count].lexeme,\"var\"))\n                {\n                    tokens->tokens[tokens->count].type = TOKEN_VAR;\n                }\n                else\n                {\n                    tokens->tokens[tokens->count].type = TOKEN_IDENTIFIER;\n                }\n                tokens->count++;\n            }\n            else if (buf[i] == '+')\n            {\n                int success = add_token(tokens,\"+\",TOKEN_PLUS,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '-')\n            {\n                int success = add_token(tokens,\"-\",TOKEN_MINUS,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '*')\n            {\n                int success = add_token(tokens,\"*\",TOKEN_STAR,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '/')\n            {\n                int success = add_token(tokens,\"/\",TOKEN_SLASH,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == ';')\n            {\n                int success = add_token(tokens,\";\",TOKEN_SEMICOLON,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == ':')\n            {\n                int success = add_token(tokens,\":\",TOKEN_COLON,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == ',')\n            {\n                int success = add_token(tokens,\",\",TOKEN_COMMA,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '=' && buf[i+1] != '=')\n            {\n                int success = add_token(tokens,\"=\",TOKEN_EQUAL,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '=' && buf[i+1] == '=')\n            {\n                int success = add_token(tokens,\"==\",TOKEN_DOUBLE_EQUAL,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i += 2;\n            }\n            else if (buf[i] == '~' && buf[i+1] == '=')\n            {\n                int success = add_token(tokens,\"~=\",TOKEN_NOT_EQUAL,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i += 2;\n            }\n            else if (buf[i] == '(')\n            {\n                int success = add_token(tokens,\"(\",TOKEN_LPAREN,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == ')')\n            {\n                int success = add_token(tokens,\")\",TOKEN_RPAREN,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '[')\n            {\n                int success = add_token(tokens,\"[\",TOKEN_LBRACKET,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == ']')\n            {\n                int success = add_token(tokens,\"]\",TOKEN_RBRACKET,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '{')\n            {\n                int success = add_token(tokens,\"{\",TOKEN_LCURLY,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '}')\n            {\n                int success = add_token(tokens,\"}\",TOKEN_RCURLY,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n            }\n            else if (buf[i] == '\"')\n            {\n                int success = realloc_tokens(tokens,1);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                i++;\n                int start = i;\n                tokens->tokens[tokens->count].column = i;\n                tokens->tokens[tokens->count].line = line;\n                tokens->tokens[tokens->count].type = TOKEN_STRING;\n                while (buf[i] != '\"' && buf[i] != '\\n' && buf[i] != '\\0')\n                {\n                    i++;\n                    if (buf[i] == '\\n' || buf[i] == '\\0')\n                    {\n                        printf(C_RED\"neolang: unclosed string on line %u\\n\"C_RESET, line);\n                        return 1;\n                    }\n                }\n                int n = i - start;\n                strncpy(tokens->tokens[tokens->count].lexeme,buf + start,n);\n                tokens->tokens[tokens->count].lexeme[n] = '\\0';\n                tokens->count++;\n                i++;\n            }\n            else \n            {\n                char short_buf[2];\n                short_buf[0] = buf[i];\n                short_buf[1] = '\\0';\n                int success = add_token(tokens,short_buf,TOKEN_UNKNOWN,line,i);\n                if (success != 0)\n                {\n                    printf(C_RED\"neolang: failed to add token\\n\"C_RESET);\n                    return 1;\n                }\n                printf(C_RED\"neolang: unknown token at column %d, line %u\\n\"C_RESET, i, line);\n                i++;\n            }\n        }\n        \n    }\n\n    fclose(file);\n    return 0;\n}"
    },
    {
      "path": "src/parser.c",
      "encoding": "utf-8",
      "content": "#include \"parser.h\"\n#include \"colors.h\"\n#include \"neostd.h\"\n#include <stdlib.h>\n#include <string.h>\n\nstatic int parser_error(char *__restrict__ _msg, int code)\n{\n    printf(_msg);\n    return code;\n}\n\nint is_at_end(Parser *parser)\n{\n    if (parser->current >= parser->tokens->count)\n        return 1;\n\n    return 0;\n}\n\nToken *previous(Parser *parser)\n{\n    return &parser->tokens->tokens[parser->current - 1];\n}\n\nToken *advance(Parser *parser)\n{\n    if (!is_at_end(parser))\n        parser->current++;\n\n    return previous(parser);\n}\n\nToken *peek(Parser *parser)\n{\n    return &parser->tokens->tokens[parser->current];\n}\n\nASTProgram *ast_program_create(void)\n{\n    ASTProgram *node = malloc(sizeof(ASTNode));\n\n    node->statements = NULL;\n    node->count = 0;\n\n    return node;\n}\n\nint ast_node_add(ASTProgram *program, ASTNode *statement)\n{\n    ASTNode **temp = realloc(\n        program->statements,\n        (program->count + 1) * sizeof(ASTNode *)\n    );\n\n    if (temp == NULL)\n        return 1;\n\n    program->statements = temp;\n    program->statements[program->count] = statement;\n    program->count++;\n\n    return 0;\n}\n\nint parser_parse(Parser *parser)\n{\n    parser->program = malloc(sizeof(ASTProgram));\n    if (parser->program == NULL)\n    {\n        return parser_error(C_RED\"neolang: failed to intialize program node\\n\"C_RESET,1);\n    }\n\n    parser->program->count = 0;\n    parser->program->statements = NULL;\n    \n    parser->current = 0;\n    ASTNode buf_node;\n    ASTNode buf_node_two;\n    while (!is_at_end(parser))\n    {\n        Token *token = advance(parser);\n\n        if (token->type == TOKEN_VAR)\n        {\n            buf_node.type = AST_DECLARATION;\n            if (peek(parser)->type != TOKEN_IDENTIFIER)\n            {\n                printf(C_RED\"neolang: unexpected token after var on line %u\\n\"C_RESET,token->line);\n                return 1;\n            }\n            token = advance(parser);\n            buf_node.data.declaration.name = malloc(sizeof(ASTNode));\n            if (buf_node.data.declaration.name == NULL)\n            {\n                return parser_error(C_RED\"neolang: failed to create AST node\\n\"C_RESET,1);\n            }\n            buf_node.data.declaration.name->type = AST_VARIABLE;\n            strcpy(buf_node.data.declaration.name->data.variable_name,token->lexeme);\n            if (peek(parser)->type != TOKEN_EQUAL)\n            {\n                printf(C_RED\"neolang: unexpected token after %s on line %u\\n\"C_RESET,token->lexeme,token->line);\n                return 1;\n            }\n            token = advance(parser);\n            if (peek(parser)->type != TOKEN_NUMBER && peek(parser)->type != TOKEN_HEX && peek(parser)->type != TOKEN_IDENTIFIER && \n                peek(parser)->type != TOKEN_STRING)\n            {\n                printf(C_RED\"neolang: unexpected token after %s on line %u\\n\"C_RESET,token->lexeme,token->line);\n                return 1;\n            }\n            if (advance(parser)->type != TOKEN_SEMICOLON)\n            {\n                printf(C_RED\"neolang: unexpected token after %s on line %u\\n\"C_RESET,token->lexeme,token->line);\n                return 1;\n            }\n            if (token->type == TOKEN_NUMBER)\n            {\n                buf_node_two.type = AST_INTEGER;\n                buf_node_two.data.integer = atoi(token->lexeme);\n            }\n            else if (token->type == TOKEN_HEX)\n            {\n                int failed;\n                unsigned long result = strtolu(token->lexeme,&failed);\n                if (failed != 0)\n                {\n                    if (failed == 2)\n                    {\n                        printf(C_RED\"neolang: hex value contains junk '%s'\\n\"C_RESET, token->lexeme);\n                    }\n                    if (failed == 3)\n                    {\n                        printf(C_RED\"neolang: hex value too large '%s'\\n\"C_RESET, token->lexeme);\n                    }\n                    return 1;\n                }\n                buf_node_two.type = AST_HEX;\n                buf_node_two.data.hex = result;\n            }\n            else if (token->type == TOKEN_IDENTIFIER)\n            {\n                buf_node_two.type = AST_VARIABLE;\n                strcpy(buf_node_two.data.variable_name, token->lexeme);\n            }\n            else if (token->type == TOKEN_STRING)\n            {\n                buf_node_two.type = AST_STRING;\n                strcpy(buf_node_two.data.variable_name, token->lexeme);\n            }\n\n            buf_node.data.declaration.value = malloc(sizeof(ASTNode));\n            if (buf_node.data.declaration.value == NULL)\n            {\n                return parser_error(C_RED\"neolang: failed to create AST node\\n\"C_RESET,1);\n            }\n\n            *buf_node.data.declaration.value = buf_node_two;\n\n            ASTNode *newNode = malloc(sizeof(ASTNode));\n\n            if (newNode == NULL)\n            {\n                return parser_error(C_RED\"neolang: failed to create AST node\\n\"C_RESET,1);\n            }\n\n            int success = ast_node_add(parser->program,newNode);\n            if (success != 0) {return parser_error(C_RED\"neolang: failed to create AST node\\n\"C_RESET,success);}\n        }\n    }\n\n    return 0;\n}"
    },
    {
      "path": "src/neostd.c",
      "encoding": "utf-8",
      "content": "#include \"neostd.h\"\n#include <stdio.h>\n#include <limits.h>\n\nint iswhitespace(char c)\n{\n    if (c == ' ' || c == '\\t' || c == '\\r')\n    {\n        return 1;\n    }\n\n    return 0;\n}\nint isnum(char c)\n{\n    if (c >= '0' && c <= '9')\n    {\n        return 1;\n    }\n    \n    return 0;\n}\nint isxnum(char c)\n{\n    if (c >= '0' && c <= '9')\n    {\n        return 1;\n    }\n    if (c >= 'a' && c <= 'f')\n    {\n        return 1;\n    }\n    if (c >= 'A' && c <= 'F')\n    {\n        return 1;\n    }\n\n    return 0;\n}\nint isalphalet(char c)\n{\n    if (c >= 'a' && c <= 'z')\n    {\n        return 1;\n    }\n    if (c >= 'A' && c <= 'Z')\n    {\n        return 1;\n    }\n\n    return 0;\n}\n\nunsigned long strtolu(char *__restrict__ _str, int *__restrict__ _failed)\n{\n    unsigned long result = 0;\n    int i = 0;\n\n    if (_str[0] != '0' || (_str[1] != 'x' && _str[1] != 'X'))\n    {\n        if (_failed != NULL)\n        {\n            *_failed = 1;\n        }\n        return 0;\n    }\n\n    i = 2;\n\n    while (_str[i] != '\\0')\n    {\n        int val = 0;\n\n        if (_str[i] >= '0' && _str[i] <= '9')\n        {\n            val = _str[i] - '0';\n        }\n        else if (_str[i] >= 'a' && _str[i] <= 'f')\n        {\n            val = _str[i] - 'a' + 10;\n        }\n        else if (_str[i] >= 'A' && _str[i] <= 'F')\n        {\n            val = _str[i] - 'A' + 10;\n        }\n        else\n        {\n            if (_failed != NULL)\n            {\n                *_failed = 2;\n            }\n            break;\n        }\n\n        result = (result << 4) | val;\n        i++;\n    }\n\n    if (result > ULONG_MAX || _failed != NULL)\n    {\n        *_failed = 3;\n    }\n    \n    return result;\n}"
    },
    {
      "path": "src/main.c",
      "encoding": "utf-8",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"colors.h\"\n#include \"lexer.h\"\n#include \"parser.h\"\n\nvoid print_ast_node(ASTNode *__restrict__ node, int indentation)\n{\n    char type_buf[MAX_LEXEME_VALUE];\n    char str_buf[MAX_LEXEME_VALUE];\n    switch (node->type)\n    {\n    case AST_INTEGER:\n    {\n        strcpy(type_buf,\"Integer\");\n        snprintf(str_buf,sizeof(str_buf),\"%d\",node->data.integer);\n        break;\n    }\n    case AST_VARIABLE:\n    {\n        strcpy(type_buf,\"Variable\");\n        strcpy(str_buf,node->data.variable_name);\n        break;\n    }\n    case AST_DECLARATION:\n    {\n        strcpy(type_buf,\"Declaration\");\n        str_buf[0] = '\\0';\n        print_ast_node(node->data.declaration.name,indentation + 1);\n        print_ast_node(node->data.declaration.value,indentation + 1);\n        break;\n    }\n    case AST_HEX:\n    {\n        strcpy(type_buf,\"Hex\");\n        snprintf(str_buf,sizeof(str_buf),\"%lu\",node->data.hex);\n        break;\n    }\n    case AST_STRING:\n    {\n        strcpy(type_buf,\"String\");\n        strcpy(str_buf,node->data.variable_name);\n        break;\n    }\n    case AST_BINARY:\n    {\n        strcpy(type_buf,\"Binary\");\n        switch (node->data.binary.oper)\n        {\n        case 0:\n            strcpy(str_buf,\"+\");\n            break;\n        case 1:\n            strcpy(str_buf,\"-\");\n            break;\n        case 2:\n            strcpy(str_buf,\"*\");\n            break;\n        case 3:\n            strcpy(str_buf,\"/\");\n            break;\n        \n        default:\n            break;\n        }\n        print_ast_node(node->data.binary.left, indentation + 1);\n        print_ast_node(node->data.binary.right, indentation + 1);\n        break;\n    }\n    \n    default:\n        break;\n    }\n\n    for (int i = 0; i < indentation; i++)\n    {\n        printf(\"\\t\");\n    }\n\n    printf(\"%s | %s\\n\", type_buf, str_buf);\n}\n\nint main(int argc, char const *argv[])\n{\n    if (argc < 2)\n    {\n        printf(C_RED\"neolang: fatal error: no file to run\\n\"C_RESET);\n        return 1;\n    }\n\n    TokenList tokens;\n    Parser parser;\n    tokens.count = 0;\n    tokens.tokens = NULL;\n\n    int lex_success = lexer_lex(argv[1], &tokens);\n    if (lex_success != 0)\n    {\n        return lex_success;\n    }\n\n    parser.tokens = &tokens;\n\n    for (int i = 0; i < tokens.count; i++)\n    {\n        printf(\"Token #%d: %s | %d\\n\", i, tokens.tokens[i].lexeme, tokens.tokens[i].type);\n    }\n\n    int parse_success = parser_parse(&parser);\n    if (parse_success != 0)\n    {\n        return parse_success;\n    }\n\n    for (int i = 0; i < parser.program->count; i++)\n    {\n        print_ast_node(parser.program->statements[i],0);\n    }\n    \n    return 0;\n}\n"
    }
  ]
}